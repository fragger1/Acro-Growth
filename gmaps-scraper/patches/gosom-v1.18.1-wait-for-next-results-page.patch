@@ -0,0 +1,106 @@
+package gmaps
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gosom/scrapemate"
+	"github.com/stretchr/testify/require"
+)
+
+// fakeFeedPage reports scripted feed heights: each Eval (a scroll or a feed poll) returns
+// the next height, repeating the last one. Polls report the end-of-list marker once the
+// height reaches endHeight (0 = never).
+type fakeFeedPage struct {
+	scrapemate.BrowserPage
+
+	heights   []int
+	endHeight int
+	pollErr   error
+
+	calls  int
+	polls  int
+	maxSeen int
+}
+
+func (p *fakeFeedPage) next() int {
+	h := p.heights[min(p.calls, len(p.heights)-1)]
+	p.calls++
+	p.maxSeen = max(p.maxSeen, h)
+
+	return h
+}
+
+func (p *fakeFeedPage) Eval(js string, _ ...any) (any, error) {
+	if !strings.Contains(js, "reached the end of the list") {
+		return float64(p.next()), nil
+	}
+
+	p.polls++
+
+	if p.pollErr != nil {
+		return nil, p.pollErr
+	}
+
+	h := p.next()
+
+	return []any{float64(h), p.endHeight != 0 && h == p.endHeight}, nil
+}
+
+func (p *fakeFeedPage) WaitForTimeout(time.Duration) {
+	time.Sleep(time.Millisecond)
+}
+
+func TestScrollWaitsForNextPageThatArrivesLate(t *testing.T) {
+	// The first 20 results are fully rendered at 1500; the next page only lands after
+	// two more polls, then the list ends at 2700.
+	page := &fakeFeedPage{heights: []int{1000, 1500, 1500, 1500, 1500, 2200, 2700, 2700}, endHeight: 2700}
+
+	cnt, err := scroll(context.Background(), page, 12, "div[role='feed']")
+
+	require.NoError(t, err)
+	require.Equal(t, 2700, page.maxSeen)
+	require.Equal(t, 5, cnt)
+}
+
+func TestScrollStopsRightAwayAtEndOfList(t *testing.T) {
+	page := &fakeFeedPage{heights: []int{1000, 1000}, endHeight: 1000}
+
+	start := time.Now()
+	cnt, err := scroll(context.Background(), page, 12, "div[role='feed']")
+
+	require.NoError(t, err)
+	require.Equal(t, 2, cnt)
+	require.Equal(t, 1, page.polls)
+	require.Less(t, time.Since(start), time.Second)
+}
+
+func TestScrollGivesUpWhenFeedStaysUnchanged(t *testing.T) {
+	old := feedStallTimeout
+	feedStallTimeout = 300 * time.Millisecond
+
+	defer func() { feedStallTimeout = old }()
+
+	page := &fakeFeedPage{heights: []int{1000, 1000}}
+
+	start := time.Now()
+	cnt, err := scroll(context.Background(), page, 12, "div[role='feed']")
+
+	require.NoError(t, err)
+	require.Equal(t, 2, cnt)
+	require.GreaterOrEqual(t, time.Since(start), 300*time.Millisecond)
+	require.Less(t, time.Since(start), 5*time.Second)
+}
+
+func TestScrollStopsWithWhatItHasWhenFeedCannotBeRead(t *testing.T) {
+	page := &fakeFeedPage{heights: []int{1000, 1000}, pollErr: errors.New("feed gone")}
+
+	cnt, err := scroll(context.Background(), page, 12, "div[role='feed']")
+
+	require.NoError(t, err)
+	require.Equal(t, 2, cnt)
+	require.Equal(t, 1, page.polls)
+}
