+// feedStallTimeout is a var so tests can shorten it.
+var feedStallTimeout = 10 * time.Second
+
+const feedPollInterval = 250 * time.Millisecond
+
+// waitForFeedGrowth polls the results feed (keeping it scrolled to the bottom) until its
+// scroll height differs from height, Maps shows "You've reached the end of the list", or
+// feedStallTimeout passes. It returns the feed's height, which equals height unless the
+// feed grew. If the feed can't be read it returns height, so the caller stops scrolling
+// with what it already has, as it did before this wait existed.
+func waitForFeedGrowth(ctx context.Context, page scrapemate.BrowserPage, scrollSelector string, height int) int {
+	expr := `() => {
+		const el = document.querySelector("` + scrollSelector + `");
+		el.scrollTop = el.scrollHeight;
+		return [el.scrollHeight, /reached the end of the list/i.test(el.innerText)];
+	}`
+
+	deadline := time.Now().Add(feedStallTimeout)
+
+	for time.Now().Before(deadline) {
+		select {
+		case <-ctx.Done():
+			return height
+		default:
+		}
+
+		v, err := page.Eval(expr)
+		if err != nil {
+			return height
+		}
+
+		state, ok := v.([]any)
+		if !ok || len(state) != 2 {
+			return height
+		}
+
+		var newHeight int
+
+		switch h := state[0].(type) {
+		case int:
+			newHeight = h
+		case float64:
+			newHeight = int(h)
+		default:
+			return height
+		}
+
+		if newHeight != height {
+			return newHeight
+		}
+
+		if ended, _ := state[1].(bool); ended {
+			return height
+		}
+
+		page.WaitForTimeout(feedPollInterval)
+	}
+
+	return height
+}
